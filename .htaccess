# ═══════════════════════════════════════════════════════════════════════
# pr3cise.com — configuración Apache · 2026-08-03
#
# Este archivo solo tiene efecto si el hosting usa Apache. En Nginx,
# Cloudflare Pages, Netlify o Vercel se ignora sin causar ningún problema:
# en ese caso hay que trasladar el equivalente a la configuración del host.
#
# Todas las directivas van dentro de <IfModule>, así que si un módulo no
# está disponible se omiten en lugar de tumbar el sitio con un error 500.
# ═══════════════════════════════════════════════════════════════════════

# ── Página 404 personalizada ──────────────────────────────────────────
ErrorDocument 404 /404.html

# ── Compresión ────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>

# ── Caché del navegador ───────────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                "access plus 1 year"
    ExpiresByType application/javascript  "access plus 1 year"
    ExpiresByType image/webp              "access plus 1 year"
    ExpiresByType image/jpeg              "access plus 1 year"
    ExpiresByType image/png               "access plus 1 year"
    ExpiresByType image/svg+xml           "access plus 1 year"
    ExpiresByType image/x-icon            "access plus 1 year"
    # El HTML se revalida siempre para que los cambios se publiquen al instante
    ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

# ── Tipos MIME que algunos servidores antiguos no traen ───────────────
<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType image/svg+xml .svg
</IfModule>

# ── Protección de áreas privadas ──────────────────────────────────────
# robots.txt solo pide a los rastreadores que no entren; NO impide el acceso.
# Esto sí lo bloquea de verdad a nivel de servidor.
<IfModule mod_authz_core.c>
    <DirectoryMatch "^.*/(presupuestos|admin)/">
        Require all denied
    </DirectoryMatch>
</IfModule>

# Evita que se sirvan archivos fuente si acaban subidos por error
<FilesMatch "\.(psd|xlsx?|docx?|md|py|log|bak)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

# ═══════════════════════════════════════════════════════════════════════
# CANONICALIZACIÓN DE DOMINIO
#
# Comprobado el 2026-08-03: las cuatro variantes del dominio devolvían 200
# sin redirigir entre ellas (http/https × con y sin www). Es decir, la misma
# web vivía en 4 URLs distintas: contenido duplicado y señales de ranking
# repartidas. Estas reglas lo unifican en https://pr3cise.com, que es lo que
# declaran las etiquetas canonical de todas las páginas.
#
# La condición X-Forwarded-Proto evita el bucle infinito clásico que se
# produce cuando el SSL se termina en un proxy y %{HTTPS} llega siempre
# como "off" al Apache de detrás.
# ═══════════════════════════════════════════════════════════════════════
<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1) Forzar HTTPS
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # 2) Quitar el www (los canonical apuntan a la versión sin www)
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
</IfModule>
