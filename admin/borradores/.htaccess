# Bloquea el acceso web directo a los borradores de articulos.
# Sin esto, cualquiera podría leer los borradores sin pasar por el panel.

# Apache 2.4+
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
