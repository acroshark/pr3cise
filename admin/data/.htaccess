# Bloquea el acceso web directo a la base de datos de leads.
# Sin esto, cualquiera podría descargar pr3cise.db escribiendo la URL.

# Apache 2.4+
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
